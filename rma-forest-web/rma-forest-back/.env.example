# ============================================
# SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS
# ============================================
# Opción 1: SQLite (recomendado para desarrollo)
DB_TYPE=sqlite
DB_NAME=database.sqlite

# Opción 2: MySQL (para producción)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña
# DB_NAME=tu_db

# ============================================
# EMAIL
# ============================================
# Opción 1: Ethereal (recomendado para pruebas)
SMTP_TYPE=ethereal

# Opción 2: SMTP real (para producción)
# SMTP_TYPE=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu_usuario@gmail.com
# SMTP_PASS=tu_contraseña

# ============================================
# JWT
# ============================================
JWT_SECRET=tu_clave_secreta

# ============================================
# RECAPTCHA
# ============================================
# Key de prueba que funciona en localhost
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe